{
  "name": "api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "build": "tsc",
    "start": "node --env-file=.env dist/server.js",
    "worker": "tsx --env-file=.env src/workers/contract-parser.worker.ts",
    "sla-checker": "tsx --env-file=.env src/workers/sla-checker.ts",
    "rag-updater": "tsx --env-file=.env src/workers/rag-updater.ts",
    "lint": "tsc --noEmit",
    "prisma": "prisma",
    "db:migrate": "prisma migrate dev",
    "db:seed": "prisma db seed"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/s3-request-presigner": "^3.700.0",
    "@clerk/fastify": "^2.0.0",
    "@fastify/compress": "^8.3.1",
    "@fastify/cors": "^10.0.0",
    "@fastify/multipart": "^9.0.0",
    "@prisma/client": "^6.3.0",
    "@supabase/supabase-js": "^2.99.2",
    "@tar/shared": "workspace:*",
    "bullmq": "^5.30.0",
    "diff": "^8.0.3",
    "fastify": "^5.2.0",
    "ioredis": "^5.4.0",
    "mammoth": "^1.8.0",
    "openai": "^6.32.0",
    "pdf-parse": "^1.1.1",
    "pdf-to-img": "^5.0.0",
    "resend": "^6.9.3",
    "tesseract.js": "^5.1.0",
    "zod": "^3.24.0"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "devDependencies": {
    "@types/diff": "^8.0.0",
    "@types/node": "^22.0.0",
    "@types/pdf-parse": "^1.1.4",
    "prisma": "^6.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
